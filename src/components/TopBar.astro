---
import { site } from "../data/site";
---

<div class="top">
  <a class="wordmark" href="/">{site.name}</a>
  <div class="top-end">
    <nav class="nav" aria-label="Primary">
      {
        site.nav.map((item) => (
          <a
            href={item.href}
            {...(item.href.startsWith("http") || item.href.endsWith(".pdf")
              ? { rel: "noopener noreferrer" }
              : {})}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <button
      type="button"
      class="theme-toggle"
      data-theme-toggle
      aria-label="Switch to dark theme"
    >
      <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true">
        <path
          fill="currentColor"
          d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
      </svg>
      <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.75"></circle>
        <path
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          d="M12 3v1.6M12 19.4V21M3 12h1.6M19.4 12H21M5.6 5.6l1.1 1.1M17.3 17.3l1.1 1.1M5.6 18.4l1.1-1.1M17.3 6.7l1.1-1.1"
        ></path>
      </svg>
    </button>
  </div>
</div>
