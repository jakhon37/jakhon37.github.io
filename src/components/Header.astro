---
import { site } from "../data/site";
import TopBar from "./TopBar.astro";
---

<TopBar />

<header class="hero" id="intro">
  <div class="hero-copy">
    <p class="eyebrow">{site.title} · {site.focus}</p>
    <h1>{site.statement}</h1>
    <p class="lede">{site.lede}</p>
    <p class="affiliation">{site.affiliation}</p>
    <p class="links">
      {
        site.links.map((link, index) => (
          <>
            {index > 0 && <span class="sep">/</span>}
            <a
              href={link.href}
              {...(link.href.startsWith("http")
                ? { rel: "noopener noreferrer" }
                : {})}
            >
              {link.label}
            </a>
          </>
        ))
      }
    </p>
  </div>
  <figure class="portrait-wrap">
    <img
      class="portrait portrait-light"
      src={site.portrait.src}
      alt={site.portrait.alt}
      width="460"
      height="460"
    />
    <img
      class="portrait portrait-dark"
      src="/portrait-dark.png"
      alt={site.portrait.alt}
      width="460"
      height="460"
    />
  </figure>
</header>
